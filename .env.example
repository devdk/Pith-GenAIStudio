# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL="file:./dev.db"

# ElevenLabs — narration TTS, speech-to-text word alignment, voice cloning
ELEVENLABS_API_KEY=""

# Magnific/Freepik — Kling image-to-video + Latent Sync lip-sync (presenter style)
MAGNIFIC_API_KEY=""

# Optional: enables the "Draft beats with AI" button
ANTHROPIC_API_KEY=""

# Optional: where uploads/renders live (default ./storage)
# STORAGE_DIR="./storage"
